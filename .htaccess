# ==============================================================================
# CIPCard Platform - Root Apache Configuration (.htaccess)
# Domain: cipcard.ir
# Clean URLs, Security Hardening, Dynamic Routing for @09xxxxxxxxx & Front Controller
# ==============================================================================

DirectoryIndex index.php public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0. Enforce HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 1. Block direct access to hidden files and sensitive directories
    RewriteRule ^(\.git|\.env|composer\.(json|lock)|database|app|views|storage)/ - [F,L,NC]
    RewriteRule \.(sql|log|ini|sh|bak)$ - [F,L,NC]

    # 2. Direct access to public assets & uploads
    RewriteRule ^(assets|uploads)/(.*)$ public/$1/$2 [L,NC]

    # 3. Profile Short URL Routing: cipcard.ir/@09123456789 or @slug
    RewriteRule ^@([^/]+)/?$ public/index.php?route=profile&mobile=$1 [QSA,L]

    # 4. Route all other requests to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]

    # If already in public directory
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^public/(.*)$ public/index.php [QSA,L]
</IfModule>

# Security Headers & MIME Types
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Performance: Compression & Caching
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/javascript application/json font/truetype font/opentype
</IfModule>

# Custom vCard and Font MIME types
AddType text/vcard .vcf
AddType font/woff2 .woff2
AddType font/woff .woff

Options -Indexes -MultiViews
