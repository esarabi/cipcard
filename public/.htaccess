# ==============================================================================
# CIPCard Platform - Public Directory Apache Configuration (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Profile Short URL Routing: @09123456789 or @9123456789
    RewriteRule ^@0?(9[0-9]{9})/?$ index.php?route=profile&mobile=0$1 [QSA,L]

    # 2. If requested file or directory exists in public/, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Pass all other requests to Front Controller (index.php)
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes -MultiViews
